function ensureToken(t,force,badToken)if not force and t.token and os.time()<t.exp then return true end
local waited=0
while t.busy and waited<20 do task.wait(.1);waited=waited+.1 end
if force and t.token and t.token~=badToken and os.time()<t.exp then return true end
if not force and t.token and os.time()<t.exp then return true end
t.busy=true
if not t.loaded then t.loaded=true;loadSession(t)end
local ok=false
for attempt=1,4 do
if t.refresh then
if refreshTok(t)then ok=true;break end
end
if not t.refresh then
if signUp(t)then ok=true;break end
end
task.wait(.5*attempt)end
t.busy=false
return ok
end
end
