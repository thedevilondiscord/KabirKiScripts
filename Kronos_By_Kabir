    frame.Parent = MessageScroll
    corner(frame, 9)

    local tag = label(
        frame,
        "[" .. data.tag .. "]",
        UDim2.fromOffset(72, 18),
        UDim2.fromOffset(8, 5),
        8,
        data.tag == "ARCHITECT" and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(255, 190, 70)
    )
    tag.Font = Enum.Font.GothamBold

    local name = label(
        frame,
        data.name,
        UDim2.new(1, -90, 0, 18),
        UDim2.fromOffset(82, 5),
        10,
        Color3.fromRGB(245, 245, 250)
    )
    name.Font = Enum.Font.GothamBold

    local text = label(
        frame,
        data.text,
        UDim2.new(1, -16, 0, 23),
        UDim2.fromOffset(8, 24),
        11,
        Color3.fromRGB(205, 205, 215)
    )

    local clickTarget = Instance.new("TextButton")
    clickTarget.Size = UDim2.fromScale(1, 1)
    clickTarget.BackgroundTransparency = 1
    clickTarget.Text = ""
    clickTarget.ZIndex = 10
    clickTarget.Parent = frame

    local pressStart = 0
    clickTarget.MouseButton1Down:Connect(function()
        pressStart = os.clock()
        task.delay(0.55, function()
            if os.clock() - pressStart >= 0.55 and clickTarget.Parent then
                ShowMessageOptions(frame, data)
            end
        end)
    end)

    clickTarget.MouseButton1Up:Connect(function()
        pressStart = 0
    end)
end

