local function ShowMessageOptions(messageFrame, messageData)
    local old = Main:FindFirstChild("MessageOptions")
    if old then old:Destroy() end

    local popup = Instance.new("Frame")
    popup.Name = "MessageOptions"
    popup.Size = UDim2.fromOffset(190, 112)
    popup.Position = UDim2.new(0, 18, 0, 88)
    popup.BackgroundColor3 = Color3.fromRGB(18, 18, 27)
    popup.BackgroundTransparency = 0.02
    popup.BorderSizePixel = 0
    popup.ZIndex = 100
    popup.Parent = Main
    corner(popup, 10)
    stroke(popup, 1.5, Color3.fromRGB(255, 0, 0), 0.25)

    label(popup, "MESSAGE OPTIONS", UDim2.new(1, -16, 0, 20),
        UDim2.fromOffset(8, 5), 9, Color3.fromRGB(255, 70, 70)).ZIndex = 101

    local options = {"Copy", "Reply", "Private Message", "Close"}

    for i, option in ipairs(options) do
        local b = button(popup, option, UDim2.new(1, -16, 0, 20),
            UDim2.fromOffset(8, 26 + (i - 1) * 21))
        b.ZIndex = 101

        b.MouseButton1Click:Connect(function()
            if option == "Close" then
                popup:Destroy()
            elseif option == "Copy" then
                if setclipboard then
                    pcall(setclipboard, messageData.text)
                end
                b.Text = "Copied!"
                task.delay(0.7, function()
                    if b.Parent then b.Text = option end
                end)
            elseif option == "Reply" then
                MessageInput.Text = "@" .. messageData.name .. " "
                MessageInput:CaptureFocus()
                popup:Destroy()
            elseif option == "Private Message" then
                MessageInput.Text = "/w " .. messageData.name .. " "
                MessageInput:CaptureFocus()
                popup:Destroy()
            end
        end)
    end
end

local function AddMessage(data)
