--// STARTUP
--// ================================================================

RefreshMessages()

task.spawn(function()
    local duration = 1.8
    local elapsed = 0

    while elapsed < duration do
        local dt = task.wait()
        elapsed += dt

        local p = math.clamp(elapsed / duration, 0, 1)
        LoadFill.Size = UDim2.new(p, 0, 1, 0)

        if p < 0.35 then
            IntroStatus.Text = "> Building V1 interface..."
        elseif p < 0.7 then
            IntroStatus.Text = "> Loading simulated chat..."
        else
            IntroStatus.Text = "> All systems ready!"
        end
    end

    task.wait(0.25)

    local fade = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    TweenService:Create(IntroBG, fade, {
        BackgroundTransparency = 1
    }):Play()

    TweenService:Create(IntroCard, fade, {
        BackgroundTransparency = 1
    }):Play()

    for _, obj in ipairs(IntroCard:GetDescendants()) do
        if obj:IsA("TextLabel") then
            TweenService:Create(obj, fade, {TextTransparency = 1}):Play()
        elseif obj:IsA("UIStroke") then
            TweenService:Create(obj, fade, {Transparency = 1}):Play()
        elseif obj:IsA("Frame") then
            TweenService:Create(obj, fade, {BackgroundTransparency = 1}):Play()
        end
    end

    task.wait(0.4)
    Intro:Destroy()
    Gui.Enabled = true
end)
