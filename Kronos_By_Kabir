local function SetTab(tabName)
    ActiveTab = tabName

    InputBar.Visible = (tabName == "GLOBAL" or tabName == "SERVER" or tabName == "STICKERS")
    for name, b in pairs(TabButtons) do
        b.BackgroundColor3 =
            name == tabName
            and Color3.fromRGB(200, 30, 30)
            or Color3.fromRGB(35, 35, 45)
    end

    MessageScroll.Visible = tabName ~= "ABOUT"
    AboutPanel.Visible = tabName == "ABOUT"
    ProfilePanel.Visible = tabName == "PROFILE"

    if tabName == "STICKERS" then
        StickerPanel.Visible = true
    elseif tabName ~= "STICKERS" then
        StickerPanel.Visible = false
    end

    RefreshMessages()
end

for name, b in pairs(TabButtons) do
    b.MouseButton1Click:Connect(function()
