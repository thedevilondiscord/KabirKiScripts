local body=new("ScrollingFrame",{Position=U2o(10,38),Size=U2n(1,-20,1,-128),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,CanvasSize=U2n(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ZIndex=81,Parent=h})
new("TextLabel",{Size=U2n(1,-8,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,RichText=true,Text=(quota and HELP_WHY or"")..HELP_WAYS,Font=T.font,TextSize=11,TextColor3=T.text,TextWrapped=true,TextXAlignment=XAL,TextYAlignment=Enum.TextYAlignment.Top,ZIndex=82,Parent=body})
local kb=new("TextBox",{Position=U2n(0,10,1,-84),Size=U2n(1,-84,0,32),BackgroundColor3=WHITE,BackgroundTransparency=.9,PlaceholderText="Paste your YouTube key",PlaceholderColor3=T.mut,Text="",TextColor3=T.text,TextSize=12,Font=T.font,ClearTextOnFocus=false,TextXAlignment=XAL,ZIndex=81,Parent=h},{corner(10),pad(0,10)})
local sv=new("TextButton",{AnchorPoint=Vector2.new(1,0),Position=U2n(1,-10,1,-84),Size=U2o(60,32),BackgroundColor3=T.accA,BackgroundTransparency=.15,Text="Save",Font=T.fontB,TextSize=11,TextColor3=WHITE,AutoButtonColor=false,ZIndex=81,Parent=h},{corner(10)})
local ks=new("TextLabel",{Position=U2n(0,10,1,-48),Size=U2n(1,-20,0,40),BackgroundTransparency=1,TextWrapped=true,Text=M.userKey and"Your own key is saved on this device."or"",Font=T.font,TextSize=10,TextColor3=T.mut,TextXAlignment=XAL,TextYAlignment=Enum.TextYAlignment.Top,ZIndex=81,Parent=h})
local busy=false
local function saveKey()if busy then return end
local t=trimS(kb.Text)
if t==""then
M.userKey=nil
YT_KEY=CONFIG.MUSIC_YT_KEY or""savePrefs()ks.Text="Back to the shared key."return
end
if#t<30 or#t>60 or not t:match("^[%w_%-]+$")then
ks.Text="That doesn't look like a YouTube key. It is about 39 letters and numbers, usually starting with AIza."return
end
busy=true
ks.Text="Checking your key..."
task.spawn(function()local old=YT_KEY
YT_KEY=t
M.quiet=true
local info,err=videoDetails({"jNQXAC9IVRw"})
M.quiet=false
busy=false
if not V.alive or not h.Parent then
if not info then YT_KEY=old end
return
end
if not info then
YT_KEY=old
ks.Text="That key didn't work: "..tostring(err)return
