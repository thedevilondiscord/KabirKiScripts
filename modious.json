Lib.loading=true
if Lib.onChange then pcall(Lib.onChange)end
task.spawn(function()
local raw,fresh,cached
local t=0
pcall(function()if isfile(LIB_TS)then t=tonumber(readfile(LIB_TS))or 0 end end)
pcall(function()if isfile(LIB_FILE)then cached=readfile(LIB_FILE)end end)
if cached and not force and os.time()-t<LIB_TTL then raw=cached end
if not raw then
local body=getBody(LIB_URL)
if body and#body>200 then raw=body;fresh=true end
end
if not raw and cached then raw=cached end
local lib,err
if raw then lib,err=parseLib(raw)else err="couldn't download the song library"end
if not lib and fresh and cached then lib,err=parseLib(cached);fresh=false end
Lib.loading=false
if not V.alive then return end
if lib then
Lib.genres,Lib.flat,Lib.total,Lib.skipped=lib.genres,lib.flat,lib.total,lib.skipped
Lib.state="ready"
Lib.err=nil
if fresh then pcall(function()if writefile then writefile(LIB_FILE,raw);writefile(LIB_TS,tostring(os.time()))end end)end
elseif Lib.state~="ready"then
Lib.state="error"
Lib.err=err
end
if Lib.onChange then pcall(Lib.onChange)end
end)
end
local function searchLib(q)
q=q:lower()
local tokens={}
for w in q:gmatch("%S+")do tokens[#tokens+1]=w end
if#tokens==0 then return{},0 end
local pool={}
local seen={}
for _,s in ipairs(Lib.flat)do
if not seen[s.id]then
seen[s.id]=true
pool[#pool+1]=s
end
end
for _,pl in ipairs(pls)do
for _,s in ipairs(PS.songs[pl.id]or{})do
if not seen[s.id]then
seen[s.id]=true
s.channel=pl.name
pool[#pool+1]=s
end
end
end
for _,s in ipairs(SD.list)do
if not seen[s.id]then
seen[s.id]=true
local t=s.title or s.name
pool[#pool+1]={id=s.id,title=t,len=0,channel="Saved",low=t:lower()}
end
end
local out={}
for _,s in ipairs(pool)do
local ok=true
for _,w in ipairs(tokens)do if not s.low:find(w,1,true)then ok=false;break end end
if ok then out[#out+1]={s=s,sc=s.low:find(q,1,true)and 1 or 2,i=#out+1}end
end
table.sort(out,function(a,b)if a.sc~=b.sc then return a.sc<b.sc end return a.i<b.i end)
local res={}
for i=1,math.min(#out,60)do res[i]=out[i].s end
return res,#out
end
