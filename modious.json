local function playSingle(v)
if not isMe()then return end
playQ({items={v},i=1},1)
end
local function playView(view,shuffle)
if not isMe()then return end
playQ({items=shuffle and shuffled(view.songs)or view.songs,i=1,name=view.name},1)
setStatus("Playing \""..cut(view.name,30).."\""..(shuffle and" (shuffled)"or"").."."..autoNote())
end
local function closeView()
P.view=nil
P.waitPl=nil
renderMode()
end
local function viewHead(view)
local head=new("Frame",{Size=U2n(1,-4,0,66),BackgroundColor3=WHITE,BackgroundTransparency=.9,LayoutOrder=nextOrder(),Parent=P.list},{corner(10)})
local back=new("TextButton",{Position=U2o(6,6),Size=U2o(30,26),BackgroundColor3=WHITE,BackgroundTransparency=.88,Text="‹",Font=T.fontB,TextSize=20,TextColor3=T.text,AutoButtonColor=false,Parent=head},{corner(12)})
back.Activated:Connect(closeView)
new("TextLabel",{Position=U2o(42,6),Size=U2n(1,-48,0,26),BackgroundTransparency=1,Text=view.name.."  ·  "..#view.songs.." songs",Font=T.fontB,TextSize=13,TextColor3=T.text,TextXAlignment=XAL,TextTruncate=Enum.TextTruncate.AtEnd,Parent=head})
local all=new("TextButton",{Position=U2o(6,36),Size=U2o(100,24),BackgroundColor3=T.accA,BackgroundTransparency=.15,Text="Play all",Font=T.fontB,TextSize=12,TextColor3=WHITE,AutoButtonColor=false,Parent=head},{corner(12)})
local shuf=new("TextButton",{Position=U2o(112,36),Size=U2o(90,24),BackgroundColor3=WHITE,BackgroundTransparency=.86,Text="Shuffle",Font=T.fontB,TextSize=12,TextColor3=T.text,AutoButtonColor=false,Parent=head},{corner(12)})
all.Activated:Connect(function()playView(view,false)end)
shuf.Activated:Connect(function()playView(view,true)end)
end
renderView=function()
local view=P.view
clearList()
if not view then return end
viewHead(view)
if#view.songs==0 then
noteRow("No songs in here yet.")
return
end
P.shown=0
local function more()
local from=P.shown+1
local to=math.min(#view.songs,P.shown+LIBPAGE)
for idx=from,to do
songRow(view.songs[idx],function()
if not isMe()then return end
playQ({items=view.songs,i=idx,name=view.name},idx)
end)
end
P.shown=to
if to<#view.songs then
setMore("Load more ("..(#view.songs-to).." left)",more)
else
setMore(nil)
end
end
more()
end
local function openGenre(name)
local g=genreByName(name)
if not g then return end
P.view={name=g.name,songs=g.songs,lib=true}
renderView()
P.layout()
setStatus("Tap PLAY to start from a song, or tap a star to save it.")
end
openPl=function(pl)
local songs=PS.songs[pl.id]
if songs then
P.view={name=pl.name,songs=songs}
renderView()
P.layout()
setStatus("Tap PLAY to start from a song, or tap a star to save it.")
return
end
if YT_KEY==""then
setStatus("Loading a playlist's songs needs a YouTube key. Tap Key.")
return
end
P.waitPl=pl.id
setStatus("Loading the song list...")
PS.sync(pl,true)
end
local function ytAction(query)
if YT_KEY==""then
return"Needs a key",function()showHelp(false)end,true
end
if quotaHit()then
return"Limit reached",function()showHelp(true)end,true
end
return"Search YouTube",function()doSearch(query,nil,true)end,false
end
local function drawResults(items,head,query,kind)
clearList()
if kind=="lib"then
local text,fn,warn=ytAction(query)
headRow(head,text,fn,warn)
elseif kind=="yt"and#searchLib(query)>0 then
headRow(head,"Back to library",function()doSearch(query)end)
else
headRow(head)
end
for _,v in ipairs(items)do
songRow(v,function()playSingle(v)end)
end
if kind=="yt"and nextToken then
setMore("Load more",function()doSearch(query,nextToken,true)end)
end
end
local function renderSearch()
if P.last then
drawResults(P.last.items,P.last.head,P.last.query,P.last.kind)
return
end
clearList()
noteRow("Type a song name to search the music library, your playlists and your saved songs.")
noteRow("Paste a YouTube song link to play any song. Tap a star on a result to save it.")
if YT_KEY==""then
noteRow("YouTube search is off here. Library, playlists and links still work. Tap Key to turn it on.",true)
elseif quotaHit()then
noteRow("YouTube search is paused today (limit reached). Everything else still works. Tap Key for unlimited searching.",true)
end
end
renderLib=function()
clearList()
local txt
if Lib.loading then
txt="Updating the library..."
elseif Lib.state=="ready"then
txt="Music library  ·  "..Lib.total.." songs"
elseif Lib.state=="error"then
txt="Music library unavailable"
else
txt="Loading the music library..."
end
headRow(txt,"Refresh",function()
loadLib(true)
for _,pl in ipairs(pls)do PS.sync(pl,true)end
end)
if Lib.state=="error"and#Lib.genres==0 then
noteRow(tostring(Lib.err or"Couldn't load it")..". Check your connection and press Refresh.",true)
end
for _,g in ipairs(Lib.genres)do
listRow(g.name,#g.songs.." songs",{
{text="Open",w=50,fn=function()openGenre(g.name)end},
{text="PLAY",w=48,primary=true,fn=function()playView(g,false)end},
})
end
end
local function playPlaylist(pl)
if not isMe()then return end
local cached=PS.songs[pl.id]
if cached and#cached>0 then
playQ({items=cached,i=1,name=pl.name},1)
setStatus("Playing \""..cut(pl.name,30).."\" ("..#cached.." songs)."..autoNote())
return
end
if plBusy then return end
plBusy=true
setStatus("Loading playlist...")
task.spawn(function()
local items,err=fetchPl(pl.id)
plBusy=false
if not V.alive then return end
if not items then
setStatus("Couldn't load it: "..tostring(err))
return
end
if#items==0 then
setStatus("No playable videos in that playlist.")
return
end
setStatus("Playing \""..cut(pl.name,30).."\" ("..#items.." songs)."..autoNote())
playQ({items=items,i=1,name=pl.name},1)
end)
end
local function removePlaylist(pl)
for i,v in ipairs(pls)do
if v==pl then
table.remove(pls,i)
break
end
end
PS.songs[pl.id]=nil
PS.save()
savePl()
setStatus("Removed \""..cut(pl.name,30).."\".")
if P.paintTabs then P.paintTabs()end
renderSaved()
end
renderSaved=function()
clearList()
if#pls==0 and#SD.list==0 then
noteRow("Nothing saved yet. Paste a YouTube song or playlist link above and press Save, or tap a star on any song.")
noteRow("Saved playlists and songs also show up when you search.")
return
end
if#pls>0 then
headRow("Playlists  ·  "..#pls,"Refresh songs",function()
for _,pl in ipairs(pls)do PS.sync(pl,true)end
setStatus("Refreshing playlist songs...")
end)
for _,pl in ipairs(pls)do
local list=PS.songs[pl.id]
local sub="tap Open to load songs"
if list then
sub=#list.." songs"
elseif PS.busy[pl.id]then
sub="loading songs..."
end
listRow(pl.name,sub,{
{text="Open",w=46,fn=function()openPl(pl)end},
{text="PLAY",w=48,primary=true,fn=function()playPlaylist(pl)end},
{text="×",w=22,plain=true,fn=function()removePlaylist(pl)end},
})
end
end
if#SD.list>0 then
headRow("Songs  ·  "..#SD.list)
for i,s in ipairs(SD.list)do
local v={id=s.id,title=s.title or s.name,len=0,channel=""}
songRow(v,function()
if not isMe()then return end
local items={}
for k,x in ipairs(SD.list)do items[k]={id=x.id,title=x.title or x.name,len=0,channel=""}end
playQ({items=items,i=i,name="Saved"},i)
end)
end
end
end
renderMode=function()
if P.view then
renderView()
elseif P.mode=="lib"then
renderLib()
elseif P.mode=="saved"then
renderSaved()
else
renderSearch()
end
if P.layout then P.layout()end
end
setMode=function(mode)
P.mode=mode
P.view=nil
P.waitPl=nil
for k,b in pairs(P.tabs)do
local on=k==mode
b.BackgroundColor3=on and T.accA or WHITE
b.BackgroundTransparency=on and 0 or .9
b.TextColor3=on and WHITE or T.text
end
P.go.Text=mode=="saved"and"Save"or"Search"
P.box.PlaceholderText=mode=="saved"and"Paste a YouTube song or playlist link"or"Search a song or paste a link"
P.box.Text=""
setStatus("")
renderMode()
end
local function savePlaylist(id)
if YT_KEY==""then
setStatus("Saving a playlist needs a YouTube key. Tap Key.")
return
end
for _,v in ipairs(pls)do
if v.id==id then
setStatus("That playlist is already saved.")
return
end
end
if plBusy then return end
plBusy=true
setStatus("Checking playlist...")
task.spawn(function()
local name,err=plName(id)
plBusy=false
if not V.alive or not panel then return end
if not name then
setStatus("Couldn't save it: "..tostring(err))
return
end
pls[#pls+1]={id=id,name=name}
savePl()
PS.sync(pls[#pls])
P.box.Text=""
setStatus("Saved playlist \""..cut(name,30).."\". Loading its songs...")
if P.paintTabs then P.paintTabs()end
if P.mode=="saved"and not P.view then renderSaved()end
end)
end
local function saveSongLink(id)
if SD.find(id)then
setStatus("That song is already saved.")
return
end
if#SD.list>=SD.max then
setStatus("Saved is full ("..SD.max.." songs). Remove one first.")
return
end
setStatus("Saving...")
task.spawn(function()
local d=jsonOf(getBody("https://www.youtube.com/oembed?format=json&url="..enc("https://www.youtube.com/watch?v="..id))or"")
local t="YouTube video"
if d and type(d.title)=="string"and d.title~=""then t=cut(clean(d.title),80)end
if not V.alive or not panel then return end
if not SD.find(id)then
SD.list[#SD.list+1]={id=id,name=t,title=t}
SD.write()
end
P.box.Text=""
setStatus("Saved \""..cut(t,40).."\".")
if P.paintTabs then P.paintTabs()end
if P.mode=="saved"and not P.view then renderSaved()end
end)
end
local function saveLink(text)
text=trimS(text)
if text==""then
setStatus("Paste a YouTube song or playlist link first.")
return
end
local lid=text:match("[?&]list=([%w_%-]+)")
if not lid then
local bare=text:match("^(PL[%w_%-]+)$")
if bare and#bare>=18 then lid=bare end
end
local vid=extractId(text)
if lid and#lid>=13 and not(vid and lid:sub(1,2)=="RD")then
savePlaylist(lid)
return
end
if vid then
saveSongLink(vid)
return
end
setStatus("That doesn't look like a YouTube link. Copy a song or playlist link from YouTube and paste it here.")
end
doSearch=function(query,token,forceYT)
query=trimS(query)
if searching or query==""then return end
local low=query:lower()
if not token and not extractId(query)and low:find("list=",1,true)and(low:find("youtube",1,true)or low:find("youtu.be",1,true))then
setMode("saved")
P.box.Text=query
setStatus("That is a playlist link. Press Save to add it.")
return
end
if not token and not forceYT and not extractId(query)then
local res,n=searchLib(query)
if#res>0 then
nextToken=nil
local head=n.." found"
if n>#res then head="Top "..#res.." of "..n end
P.last={items=res,head=head,query=query,kind="lib"}
P.view=nil
drawResults(res,head,query,"lib")
P.layout()
setStatus("")
return
end
if quotaHit()or YT_KEY==""then
P.last=nil
clearList()
noteRow("No match for \""..cut(query,30).."\" in the library, your playlists or Saved.")
if YT_KEY==""then
noteRow("YouTube search is off here. Tap Key to turn it on, or paste a YouTube link to play any song.",true)
else
noteRow("YouTube search is paused today (limit reached). Tap Key for unlimited searching, or paste a YouTube link to play any song.",true)
end
P.layout()
setStatus("")
return
end
end
searching=true
setStatus("Searching YouTube...")
task.spawn(function()
local items
local tokenOut
local err
local linked=extractId(query)
local viaLink=false
if linked and not token then
M.quiet=true
items,tokenOut,err=lookupVideo(linked)
M.quiet=false
if not items then
items,tokenOut,err=linkFallback(linked)
viaLink=true
end
else
items,tokenOut,err=searchYT(query,token)
end
searching=false
if not V.alive or not panel then return end
if not items then
if quotaHit()then
setStatus("YouTube search limit reached. Library, Saved and links still work.")
else
setStatus("Search failed: "..tostring(err))
end
return
end
nextToken=tokenOut
local active=P.mode=="search"and not P.view
if token and P.last then
for _,v in ipairs(items)do P.last.items[#P.last.items+1]=v end
if active then
for _,v in ipairs(items)do songRow(v,function()playSingle(v)end)end
if nextToken then
setMore("Load more",function()doSearch(query,nextToken,true)end)
else
setMore(nil)
end
end
setStatus("")
return
end
local kind="yt"
local head="YouTube results"
if viaLink then
kind="link"
head="From your link"
end
P.last={items=items,head=head,query=query,kind=kind}
if#items==0 then
setStatus("No songs of 60 seconds or longer found.")
end
if active then
drawResults(items,head,query,kind)
P.layout()
end
if#items>0 then
setStatus(viaLink and"Link ready. Press PLAY."or"Tap a star to save a song for later.")
end
end)
end
refreshPanel=function()
if not panel or not panel.Parent or not P.now then return end
local st=M.state
local cur=M.cur
P.now.Text=(cur and cur.title~="")and cur.title or"Nothing playing"
local snd=M.sound
local text=""
local ratio=0
if M.pct then
text="Downloading "..M.pct.."%"
ratio=M.pct/100
elseif snd and snd.IsLoaded and snd.TimeLength>0 then
text=fmtTime(snd.TimePosition).." / "..fmtTime(snd.TimeLength)
ratio=math.clamp(snd.TimePosition/snd.TimeLength,0,1)
elseif cur then
text="Loading..."
end
if M.q and M.q.items[M.q.i]and#M.q.items>1 and text~=""then text=text.."  ·  "..M.q.i.."/"..#M.q.items end
P.time.Text=text
P.fill.Size=U2n(ratio,0,1,0)
P.pause.Text=(st and st.state=="pause")and"Resume"or"Pause"
P.loop.BackgroundColor3=M.loop and T.accA or WHITE
P.loop.BackgroundTransparency=M.loop and .35 or .88
P.loop.TextColor3=M.loop and WHITE or T.text
P.auto.BackgroundColor3=M.autoplay and T.accA or WHITE
P.auto.BackgroundTransparency=M.autoplay and .35 or .88
P.auto.TextColor3=M.autoplay and WHITE or T.text
P.autoNote.Text=M.autoplay and"Auto is on: songs keep playing one after another. Turn it off to play one song at a time."or"Auto is off: each song plays once, then stops. Turn it on to keep going."
if P.showV then P.showV(M.muted and 0 or M.volume)end
local line=M.status
if M.warn~=""then line=(line~=""and(line.."  ")or"")..M.warn end
P.status.TextColor3=(M.warn~="")and ORANGE or T.mut
if P.status.Text~=line then
P.status.Text=line
if P.layout then P.layout()end
end
if P.refreshHead then P.refreshHead()end
end
local HELP_WHY="<b>YouTube search is paused for today</b>\nYouTube gives this script a limited number of searches every day, shared by everyone using Saiki Rechat. The limit comes back by itself tomorrow. Nothing is broken.\n\n"
local HELP_WAYS="<b>What still works right now</b>\nSearch still finds songs in the music library, your saved playlists and your saved songs. The Library and Saved tabs work as usual, and pasting a YouTube song link in Search plays it. Links never use up searches.\n\n<b>Want unlimited searching? Use your own key</b>\nA YouTube API key is like your own free ticket for searching. It gives you your own daily limit that nobody else uses. How to get one on your phone:\n1. Open Chrome and go to console.cloud.google.com and sign in with your Google account. If the page looks tiny or odd, tap the three-dot menu and turn on \"Desktop site\".\n2. Tap the project name at the top, then New Project. Pick any name and tap Create. Wait a few seconds, then select your new project.\n3. Open the menu (three lines), tap APIs &amp; Services, then Library. Search for YouTube Data API v3, open it and tap Enable.\n4. Go back to APIs &amp; Services, then Credentials. Tap Create credentials, then API key. Your key appears. Tap the copy button.\n5. Paste the key in the box below and press Save.\n\nKeep your key private, like a password. It is saved only on your device. To go back to the shared key, clear the box and press Save."
