local LIB_URL="https://raw.githubusercontent.com/thedevilondiscord/KabirKiScripts/main/instaMusicX.json"
local LIB_FILE=CACHE.."/music_library.json"
local LIB_TS=CACHE.."/music_library_t.txt"
local LIB_TTL=6*3600
local GENRE_ORDER={"Indi","Punjabi","Phonk","Angelcore","English"}
local Lib={genres={},flat={},total=0,skipped=0,state="idle",loading=false,err=nil}
local function parseLib(raw)
local d=jsonOf(raw)
if not d or type(d.categories)~="table"then return nil,"the library file isn't valid JSON"end
local keys,seen={},{}
for _,want in ipairs(GENRE_ORDER)do
for k in pairs(d.categories)do
if tostring(k):lower()==want:lower()and not seen[k]then keys[#keys+1]=k;seen[k]=true end
end
end
local rest={}
for k in pairs(d.categories)do if not seen[k]then rest[#rest+1]=k end end
table.sort(rest,function(a,b)return tostring(a)<tostring(b)end)
for _,k in ipairs(rest)do keys[#keys+1]=k end
local genres,flat,total,skipped={},{},0,0
for _,k in ipairs(keys)do
local arr=d.categories[k]
if type(arr)=="table"then
local songs,dup={},{}
for _,it in ipairs(arr)do
local id=type(it)=="table"and type(it.url)=="string"and extractId(it.url)or nil
local nm=type(it)=="table"and type(it.name)=="string"and trimS(it.name)or nil
if id and validId(id)and nm and nm~=""and not dup[id]then
dup[id]=true
local s={id=id,title=cut(clean(nm),80),len=0,channel=tostring(k),genre=tostring(k),low=nm:lower()}
songs[#songs+1]=s
flat[#flat+1]=s
else
skipped=skipped+1
end
end
if#songs>0 then genres[#genres+1]={name=tostring(k),songs=songs};total=total+#songs end
end
end
if total==0 then return nil,"no playable songs were found in the library file"end
return{genres=genres,flat=flat,total=total,skipped=skipped}
end
local function loadLib(force)
