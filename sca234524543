			Font = T.fontB, TextSize = 15, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 61, Parent = panel })
		new("TextLabel", { Position = UDim2.fromOffset(14, 32), Size = UDim2.new(1, -28, 0, 30), BackgroundTransparency = 1, TextWrapped = true,
			Text = "Only you see these. While any switch is on it replaces your real aura.", Font = T.font, TextSize = 11, TextColor3 = T.mut,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 61, Parent = panel })
		local x = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(28, 28),
			BackgroundTransparency = 1, Text = "×", Font = T.fontB, TextSize = 22, TextColor3 = T.mut, AutoButtonColor = false, ZIndex = 61, Parent = panel })
		x.Activated:Connect(closePanel)
		local labBtn = new("TextButton", { Position = UDim2.fromOffset(124, 8), Size = UDim2.fromOffset(82, 24), BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.86, Text = "Frames lab ›", Font = T.fontB, TextSize = 11, TextColor3 = T.text, AutoButtonColor = false,
			ZIndex = 62, Parent = panel }, { corner(12) })
		labBtn.Activated:Connect(function() if lab then closeLab() else openLab() end end)
		local rows = { { "halo", "Angel Halo  ·  Tier II" }, { "hand", "Cursed Hand  ·  Tier III" }, { "wheel", "Mahoraga Wheel  ·  Tier IV" } }
		local switches = {}
		local function addSwitch(parent, on, onChange)
			local state = on
			local track = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(44, 24),
				BackgroundColor3 = WHITE, BackgroundTransparency = 0.82, Text = "", AutoButtonColor = false, ZIndex = 62, Parent = parent }, { corner(12) })
			local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = on and 0 or 1, ZIndex = 62,
				Parent = track }, { corner(12), grad(0) })
			local onPos, offPos = UDim2.new(1, -21, 0.5, 0), UDim2.new(0, 3, 0.5, 0)
			local knob = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = on and onPos or offPos, Size = UDim2.fromOffset(18, 18),
				BackgroundColor3 = WHITE, ZIndex = 63, Parent = track }, { corner(9) })
			local api = {}
			function api.set(v)
				state = v
				tween(fill, 0.2, { BackgroundTransparency = v and 0 or 1 })
				tween(knob, 0.2, { Position = v and onPos or offPos })
			end
			track.Activated:Connect(function() api.set(not state); onChange(state) end)
			return api
		end
		for i, r in ipairs(rows) do
			local row = new("Frame", { Position = UDim2.fromOffset(10, 68 + (i - 1) * 44), Size = UDim2.new(1, -20, 0, 38), BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.94, ZIndex = 61, Parent = panel }, { corner(12) })
			new("TextLabel", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -70, 1, 0), BackgroundTransparency = 1, Text = r[2], Font = T.fontB,
				TextSize = 12, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 62, Parent = row })
			switches[r[1]] = addSwitch(row, testKinds[r[1]] == true, function(v)
				testKinds[r[1]] = v or nil
				if not v then destroyAura("test:" .. r[1]) end
				recount()
			end)
		end
		local sec = new("Frame", { Position = UDim2.fromOffset(10, 68 + 3 * 44), Size = UDim2.new(1, -20, 0, 38), BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.97, ZIndex = 61, Parent = panel }, { corner(12) })
		new("TextLabel", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), BackgroundTransparency = 1, Text = "Secret Aura  ·  Tier V  ·  not developed yet",
			Font = T.font, TextSize = 12, TextColor3 = T.mut, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 62, Parent = sec })
		new("TextLabel", { Position = UDim2.fromOffset(14, 68 + 3 * 44 + 46), Size = UDim2.new(1, -28, 0, 16), BackgroundTransparency = 1,
			Text = "Avatar frame test (only you, on every avatar)", Font = T.fontB, TextSize = 11, TextColor3 = T.mut,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 61, Parent = panel })
		local fopts = { { false, "Off" }, { "t2", "Tier II" }, { "t3", "Tier III" }, { "t4a", "Tier IV-1" }, { "t4b", "Tier IV-2" },
			{ "t5", "Tier V" }, { "rose", "Roses" }, { "cursed", "Cursed" }, { "demon", "Demon" } }
		local fchips = {}
		local function paintFrames()
			for _, c in ipairs(fchips) do
				c.btn.BackgroundTransparency = (c.key == T.frameTest) and 0.7 or 0.92
			end
		end
		for i, o in ipairs(fopts) do
			local col, rowi = (i - 1) % 3, math.floor((i - 1) / 3)
			local btn = new("TextButton", { Position = UDim2.fromOffset(10 + col * 76, 68 + 3 * 44 + 66 + rowi * 32), Size = UDim2.fromOffset(72, 28),
				BackgroundColor3 = WHITE, BackgroundTransparency = 0.92, Text = o[2], Font = T.fontB, TextSize = 11, TextColor3 = T.text,
				AutoButtonColor = false, ZIndex = 61, Parent = panel }, { corner(14) })
			fchips[#fchips + 1] = { btn = btn, key = o[1] or nil }
			btn.Activated:Connect(function()
				T.frameTest = o[1] or nil
				paintFrames()
				if T.refreshFrames then pcall(T.refreshFrames) end
			end)
		end
		paintFrames()
		local off = new("TextButton", { Position = UDim2.new(0, 10, 1, -44), Size = UDim2.new(1, -20, 0, 34), BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.88, Text = "All off", Font = T.fontB, TextSize = 13, TextColor3 = T.text, AutoButtonColor = false, ZIndex = 61,
			Parent = panel }, { corner(17) })
		off.Activated:Connect(function()
			for k, sw in pairs(switches) do sw.set(false) end
			for k in pairs(testKinds) do destroyAura("test:" .. k) end
			testKinds = {}
			recount()
			T.frameTest = nil
			paintFrames()
			if T.refreshFrames then pcall(T.refreshFrames) end
		end)
	end
	local lastCmd = -1
	function T.chatCommand(txt)
		local t = string.lower(tostring(txt)):gsub("^%s+", ""):gsub("%s+$", "")
		if t ~= "!atp" then return false end
		if os.clock() - lastCmd > 0.6 then -- debounce (the Roblox chat can report the same message twice)
			lastCmd = os.clock()
			if panel then closePanel() else openPanel() end
		end
		return true
	end
	pcall(function() H.bind(LP.Chatted, function(msg) T.chatCommand(msg) end) end) -- also works from the Roblox chat box
	pcall(function()
		H.bind(game:GetService("TextChatService").MessageReceived, function(m)
			if m.TextSource and m.TextSource.UserId == LP.UserId then T.chatCommand(m.Text) end
		end)
	end)
	warn("[SAIKI RECHAT] aura test panel ready for " .. LP.Name .. ": type !atp in chat")
	H.onDestroy(function()
		closePanel()
		testKinds, testOn = {}, false
		T.chatCommand = nil
	end)
end

function T.setAuras(on)
	T.aura = on and true or false
	if not on then destroyAll() end
end
H.onDestroy(function()
	running = false
	destroyAll()
	pcall(function() folder:Destroy() end)
	T.setAuras = nil
end)
