---------------------------------------------------------------- manager: who gets which aura, drawn only for you if Aura Rendering is ON
local active = {} -- [Player or "test:<kind>"] = { kind, char, model, obj }
local testKinds, testOn = {}, false -- dev test panel: auras forced on yourself
local tiers = {}  -- [userId string] = { t = tier, at = os.clock() }

local function destroyAura(key)
	local a = active[key]
	if not a then return end
	active[key] = nil
	pcall(a.obj.destroy)
	pcall(function() a.model:Destroy() end)
end
local function destroyAll()
	for p in pairs(active) do destroyAura(p) end
end
local function ensureAura(key, kind, char)
	local a = active[key]
	if a and a.kind == kind and a.char == char then return a end
	destroyAura(key)
	local model = Instance.new("Model")
	model.Name = "Aura_" .. tostring(key)
	local ok, obj = pcall(BUILD[kind], model)
	if not ok then
		warn("[SAIKI RECHAT] aura failed: " .. tostring(obj))
		model:Destroy()
		return nil
	end
	model.Parent = folder
	a = { kind = kind, char = char, model = model, obj = obj }
	active[key] = a
	return a
end

local function sync()
	local cam = workspace.CurrentCamera
	local cpos = cam and cam.CFrame.Position
	local natural = (T.aura ~= false)
	local cands = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local char = p.Character
		local info = tiers[tostring(p.UserId)]
		local kind = info and KIND[info.t]
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if p == LP then -- dev test panel: forced auras on yourself replace your real one while any switch is on
			local alive = root and hum and hum.Health > 0
			for k, a in pairs(active) do
				if type(k) == "string" and (not testOn or not testKinds[a.kind] or not alive) then destroyAura(k) end
			end
			if testOn and alive then
				for kk in pairs(testKinds) do ensureAura("test:" .. kk, kk, char) end
			end
			if testOn then kind = nil end
		end
		if not natural and p ~= LP then kind = nil end
		if not natural and p == LP then kind = nil end
		if kind and root and hum and hum.Health > 0 then
			local d = (p == LP) and -1 or (cpos and (root.Position - cpos).Magnitude or 0)
			cands[#cands + 1] = { p = p, kind = kind, char = char, d = d }
		else
			destroyAura(p)
		end
	end
	table.sort(cands, function(x, y) return x.d < y.d end)
	local shown = 0
	for _, c in ipairs(cands) do
		local keep = (c.p == LP)
		if not keep and shown < MAX_REMOTE and c.d <= FAR then keep = true; shown = shown + 1 end
		if keep then ensureAura(c.p, c.kind, c.char) else destroyAura(c.p) end
	end
end

task.spawn(function() -- draw / remove auras
	while running do
		if T.aura ~= false or testOn then pcall(sync) else destroyAll() end
		task.wait(1)
	end
end)

task.spawn(function() -- look up follower tiers (one small request at a time, results cached)
	while running do
		if T.aura ~= false then
			for _, p in ipairs(Players:GetPlayers()) do
				if not running or T.aura == false then break end
				local id = tostring(p.UserId)
				local info = tiers[id]
				if not info or os.clock() - info.at > 90 then
					local n = FS.count(id)
					if n then
						tiers[id] = { t = FS.tierOf(n), at = os.clock() }
					elseif not info then
						tiers[id] = { t = 1, at = os.clock() - 60 } -- couldn't check, try again soon
					end
					task.wait(0.2)
				end
			end
		end
		task.wait(3)
	end
end)

