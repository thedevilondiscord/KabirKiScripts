---------------------------------------------------------------- Tier II: Angel Halo
local function buildHalo(model)
	local SEG, RADIUS, HEIGHT, THICK, SPEED = 31, 2.0, 2.3, 0.22, 0.8
	local GOLD, WHITEC = Color3.fromRGB(255, 235, 140), Color3.fromRGB(255, 255, 255)
	local parts, joints, border, pos = {}, {}, {}, {}
	local function neon(shape, color)
		local p = Instance.new("Part")
		p.Material = Enum.Material.Neon
		p.Shape = shape
		p.Anchored = true
		p.CanCollide = false
		p.CastShadow = false
		p.Color = color
		p.Parent = model
		return p
	end
	for i = 1, SEG do
		parts[i] = neon(Enum.PartType.Cylinder, GOLD)
		joints[i] = neon(Enum.PartType.Ball, GOLD)
		border[i] = neon(Enum.PartType.Cylinder, WHITEC)
	end
	local rotation = 0
	return {
		update = function(char, dt, t)
			local head = char:FindFirstChild("Head")
			if not head then return end
			rotation = rotation + dt * SPEED
			local center = head.CFrame * CFrame.new(0, HEIGHT, 0) * CFrame.Angles(0, rotation, 0)
			for i = 1, SEG + 1 do
				local angle = (i / SEG) * math.pi * 2
				local wave = math.sin(t * 1.2 + angle) * 0.02
				pos[i] = center * Vector3.new(math.cos(angle) * RADIUS, wave, math.sin(angle) * RADIUS)
			end
			for i = 1, SEG do
				local p1, p2 = pos[i], pos[i + 1]
				local len = (p2 - p1).Magnitude
				local cf = CFrame.lookAt(p1:Lerp(p2, 0.5), p2) * CFrame.Angles(0, math.rad(90), 0)
				parts[i].Size = Vector3.new(len, THICK, THICK)
				parts[i].CFrame = cf
				joints[i].Size = Vector3.new(THICK * 1.3, THICK * 1.3, THICK * 1.3)
				joints[i].CFrame = CFrame.new(p1)
				border[i].Size = Vector3.new(len + 0.05, 0.06, 0.06)
				border[i].CFrame = cf
			end
		end,
		destroy = function() end,
	}
end

---------------------------------------------------------------- Tier III: Cursed Hand (black hand, red edge glow)
local function buildHand(model)
	local BASE = Vector3.new(0, 4, 4)
	local RED = Color3.fromRGB(255, 0, 0)
	local function part(name, size)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(0, 0, 0)
		p.CanCollide = false
		p.CastShadow = false
		p.Anchored = true
		p.Transparency = 0.05
		p.Parent = model
		return p
	end
	local hl = Instance.new("Highlight") -- one outline for the whole hand (the engine only draws a limited number of highlights)
	hl.FillColor, hl.OutlineColor = RED, RED
	hl.FillTransparency, hl.OutlineTransparency = 1, 0.1
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = model
	hl.Parent = model
	local palm = part("Palm", Vector3.new(3.5, 3.5, 1))
	local data = { { -2.2, -0.5, 2.5, 45 }, { -1.2, 2, 3.5, 10 }, { 0, 2.3, 4, 0 }, { 1.2, 2, 3.5, -10 }, { 2, 1, 2.8, -25 } }
	local fingers = {}
	for i, d in ipairs(data) do
		fingers[i] = { part = part("Finger" .. i, Vector3.new(0.8, d[3], 0.8)), x = d[1], y = d[2], length = d[3], rot = math.rad(d[4]) }
	end
	return {
		update = function(char, dt, t)
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return end
			local floatY = math.sin(t * 1.5) * 0.5
			local twitchX = math.noise(t * 8, 0, 0) * 0.3
			palm.CFrame = root.CFrame * CFrame.Angles(math.rad(-20), 0, 0) * CFrame.new(BASE.X + twitchX, BASE.Y + floatY, BASE.Z)
			for i, f in ipairs(fingers) do
				local grasp = math.rad(-30) + math.sin(t * 2 + i) * math.rad(20)
				local pivot = palm.CFrame * CFrame.new(f.x, f.y, 0)
				f.part.CFrame = pivot * CFrame.Angles(grasp, 0, f.rot) * CFrame.new(0, f.length / 2, 0)
			end
		end,
		destroy = function() end,
	}
end

---------------------------------------------------------------- Tier IV: Mahoraga Wheel
local function buildWheel(model)
	local SCALE, DISTANCE, HEIGHT, ANGLEX = 0.6, 3, 3, -30
	local RADIUS, SEGMENTS, ROD_LENGTH, BALL_SIZE, CENTER_SIZE = 6.5, 100, 13, 2.5, 2.8
	local function part(name, size, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Anchored = true
		p.CanCollide = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.new(0, 0, 0)
		p.CastShadow = false
		if shape then p.Shape = shape end
		p.Parent = model
		return p
	end
	local center = part("Center", Vector3.new(CENTER_SIZE * SCALE, CENTER_SIZE * SCALE, CENTER_SIZE * SCALE), Enum.PartType.Ball)
	local ring, rods, balls = {}, {}, {}
	for i = 1, SEGMENTS do ring[i] = part("Ring", Vector3.new(0.2, 0.45, 0.35)) end
	for i = 1, 8 do
		rods[i] = part("Spoke", Vector3.new(0.45 * SCALE, ROD_LENGTH * SCALE, 0.45 * SCALE))
		balls[i] = part("Ball", Vector3.new(BALL_SIZE * SCALE, BALL_SIZE * SCALE, BALL_SIZE * SCALE), Enum.PartType.Ball)
	end
	local spin = 0
	return {
		update = function(char, dt, t)
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return end
			spin = spin + dt * 0.6
			local radius = RADIUS * SCALE
			local pos = root.Position - root.CFrame.LookVector * DISTANCE + root.CFrame.UpVector * HEIGHT
			local cf = CFrame.lookAt(pos, pos + root.CFrame.LookVector) * CFrame.Angles(math.rad(ANGLEX), 0, 0)
			center.CFrame = cf
			for i, v in ipairs(ring) do
				local a = (math.pi * 2 / SEGMENTS) * i
				v.CFrame = cf * CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0) * CFrame.Angles(0, 0, a)
			end
			for i = 1, 8 do
				local a = (math.pi * 2 / 8) * i + spin
				rods[i].CFrame = cf * CFrame.Angles(0, 0, a)
				balls[i].CFrame = cf * CFrame.new(math.cos(a) * radius * 1.45, math.sin(a) * radius * 1.45, 0)
			end
		end,
		destroy = function() end,
	}
end

