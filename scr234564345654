		if type(d) == "table" and type(d.names) == "table" then
			for id, v in pairs(d.names) do
				if type(v) == "table" and type(v.d) == "string" and type(v.u) == "string" and os.time() - (tonumber(v.t) or 0) < 604800 then
					names[id] = { dn = v.d, un = v.u, keep = true, t = tonumber(v.t) or 0 }
				end
			end
		end
	end
end)
local function saveNames()
	if not namesDirty then return end
	namesDirty = false
	pcall(function()
		if not writefile then return end
		local out = {}
		for id, v in pairs(names) do
			if v.keep then out[id] = { d = v.dn, u = v.un, t = v.t or os.time() } end
		end
		writefile(NAMEFILE, HttpService:JSONEncode({ names = out }))
	end)
end
local function apiName(id)
	if not H.request then return nil end
	local ok, res = pcall(H.request, { Url = "https://users.roblox.com/v1/users/" .. id, Method = "GET" })
	if ok and type(res) == "table" and res.StatusCode == 200 and res.Body then
		local okd, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
		if okd and type(d) == "table" and type(d.name) == "string" then
			local dn = (type(d.displayName) == "string" and d.displayName ~= "") and d.displayName or d.name
			return { dn = dn, un = d.name }
		end
	end
	return nil
end
