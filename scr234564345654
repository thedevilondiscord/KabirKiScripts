-- Everyone's client reads the caps and refuses new follows to a user who is already at their cap.
local origFollow = FS.follow
function FS.follow(id, name, user)
	local c = caps[tostring(id)]
	if c then
		local n = FS.count(id, true)
		if n and n >= c.max then return false, "this user has reached their follower limit" end
	end
	return origFollow(id, name, user)
end
H.onDestroy(function() FS.follow = origFollow end)

task.spawn(function()
	local lastSync = -1e9
	while capAlive and page.Parent do
		refreshMod()
		if os.clock() - lastSync > CAP_SYNC then
			lastSync = os.clock()
			if remoteCaps() then drawCaps() end
		end
		if isModNow() then
			for id, c in pairs(caps) do
				if not capAlive or not isModNow() then break end
				if not capBusy then
					local ok, data = FS.req("GET", "/followers/" .. id, nil, "shallow=true")
					if ok then
						local n = 0
						if type(data) == "table" then for _ in pairs(data) do n += 1 end end
						if n > c.max then
							capBusy = true
							local removed, failed = trim(id, c.max)
							if removed then n = countOf(id) or c.max end
							capBusy = false
							if removed and removed > 0 then setStatus("Auto-trimmed " .. capName(id) .. ": removed " .. removed .. (failed > 0 and (", " .. failed .. " refused") or "") .. ".", failed == 0) end
						end
						setFull(id, n >= c.max)
					end
				end
				task.wait(0.15)
			end
		end
		task.wait(CAP_POLL)
	end
end)

