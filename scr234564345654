-- names: /profiles first, Roblox lookup as fallback
local function resolve(e)
	if e.id == OWNER_ID and e.id ~= ME then
		e.dn, e.un = OWNER_NAME, ""
		return
	end
	local nm = names[e.id]
	local live = (e.id == H.me) and Players.LocalPlayer or Players:GetPlayerByUserId(tonumber(e.id) or 0)
	if live then -- live name from the game itself, never stale
		if not nm or nm.dn ~= live.DisplayName or nm.un ~= live.Name then namesDirty = true end
		nm = { dn = live.DisplayName, un = live.Name, keep = true, t = os.time() }
		names[e.id] = nm
		e.dn, e.un = nm.dn, nm.un
		return
	end
	-- Refresh cached display names from Roblox periodically; keep the cached value if the API is unavailable.
	if nm and os.time() - (tonumber(nm.t) or 0) > 300 then
		local fresh = apiName(e.id)
		if fresh then
			fresh.keep, fresh.t = true, os.time()
			if fresh.dn ~= nm.dn or fresh.un ~= nm.un or fresh.t ~= nm.t then namesDirty = true end
			names[e.id], nm = fresh, fresh
		end
	end
	if not nm then
		local pl = Players:GetPlayerByUserId(tonumber(e.id) or 0)
		if pl then nm = { dn = pl.DisplayName, un = pl.Name, keep = true, t = os.time() } end
		if not nm then
			local okp, pd = FS.req("GET", "/profiles/" .. e.id)
			if okp and type(pd) == "table" and pd.username then
				if type(pd.displayName) == "string" and pd.displayName ~= "" and pd.displayName ~= pd.username then
					nm = { dn = pd.displayName, un = pd.username, keep = true, t = os.time() }
				else
					nm = apiName(e.id) -- profile has no separate display name: ask Roblox
					if nm then nm.keep, nm.t = true, os.time() else nm = { dn = pd.username, un = pd.username } end
				end
			end
		end
		if not nm then
			nm = apiName(e.id)
			if nm then nm.keep, nm.t = true, os.time() end
		end
		if not nm then
			local oku, un = pcall(function() return Players:GetNameFromUserIdAsync(tonumber(e.id)) end)
			if oku and un then nm = { dn = un, un = un } else nm = { dn = "User " .. e.id, un = "" } end
		end
		if nm.keep then namesDirty = true end
		names[e.id] = nm
	end
	e.dn, e.un = nm.dn, nm.un
end

