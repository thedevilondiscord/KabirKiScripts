-- adds the next BATCH rows (names looked up in rank order, rows added strictly top to bottom)
function loadMore()
	if not full or loading then return end
	local from, to = shown + 1, math.min(shown + BATCH, #full)
	if from > to then return end
	local my = gen
	loading = true
	setMore()
	local list = {}
	for i = from, to do list[#list + 1] = { id = full[i].id, c = full[i].c } end

	local nextI = 0
	local function worker()
		while my == gen do
			nextI = nextI + 1
			local e = list[nextI]
			if not e then return end
			pcall(resolve, e)
		end
	end
	for _ = 1, 6 do task.spawn(worker) end

	for k, e in ipairs(list) do
		local t0 = os.clock()
		while not e.dn and os.clock() - t0 < 12 and my == gen do task.wait(0.05) end
		if my ~= gen then return end
		if not e.dn then e.dn, e.un = "User " .. e.id, "" end
		if FS.cache then FS.cache[e.id] = { c = e.c, t = os.clock() } end
		if k == 1 then
			for _, c in ipairs(sc:GetChildren()) do
				if c:IsA("GuiObject") and c.LayoutOrder == 5 then c:Destroy() end
			end
		end
		local rank = from + k - 1
		board[rank] = e
		makeRow(e, rank)
		if hdrRight and hdrRight.Parent then hdrRight.Text = "loading " .. k .. "/" .. #list end
		if k % 4 == 0 then task.wait() end -- spread row building over frames
	end
	if my ~= gen then return end
	shown = to
	loading, stamp = false, os.clock()
	saveNames()
	if hdrRight and hdrRight.Parent then hdrRight.Text = "top " .. shown end
	setMore()
end

