-- followers of a user: list of { fuid, rid, ts }
local function followersOf(id)
	local ok, data, _, code = FS.req("GET", "/followers/" .. id)
	if not ok then return nil, code end
	local list = {}
	if type(data) == "table" then
		for fuid, r in pairs(data) do
			local e = { fuid = tostring(fuid), ts = 0 }
			if type(r) == "table" then
				e.ts = tonumber(r.ts) or 0
				e.rid = tonumber(r.rid) and string.format("%.0f", tonumber(r.rid)) or nil
			end
			list[#list + 1] = e
		end
	end
	return list
end

-- takes one follower off a user, and the user off that follower's following list
local function removeFollower(target, e)
	local ok, _, _, code = FS.req("DELETE", "/followers/" .. target .. "/" .. e.fuid)
	if not ok then return false, code end
	FS.req("DELETE", "/follows/" .. e.fuid .. "/" .. target)
	if e.rid then
		FS.req("DELETE", "/following/" .. e.rid .. "/" .. target)
		if e.rid == tostring(ME) and FS.following then FS.following[target] = nil end
	end
	return true
end

-- cuts a user down to `max` followers, newest first, several at a time
local function trim(target, max)
	local list, code = followersOf(target)
	if not list then return nil, "couldn't read followers (HTTP " .. tostring(code) .. ")" end
	local excess = #list - max
	if excess <= 0 then
		if FS.cache then FS.cache[target] = { c = #list, t = os.clock() } end
		return 0, 0
	end
	table.sort(list, function(a, b)
		if a.ts ~= b.ts then return a.ts > b.ts end
		return a.fuid > b.fuid
	end)
	local nxt, done, removed, failed, lastCode = 0, 0, 0, 0, nil
	local workers = math.min(CAP_WORKERS, excess)
	for _ = 1, workers do
		task.spawn(function()
			while true do
				nxt += 1
				local i = nxt
				if i > excess then break end
				local ok, c = removeFollower(target, list[i])
				if ok then removed += 1 else failed += 1; lastCode = c end
			end
			done += 1
		end)
	end
	while done < workers do task.wait() end
	if FS.cache then FS.cache[target] = { c = #list - removed, t = os.clock() } end
	return removed, failed, lastCode
end

local capfull = {} -- [id] = true while that user is at/over their cap; the database rules refuse new follows then
local function countOf(id)
	local ok, data = FS.req("GET", "/followers/" .. id, nil, "shallow=true")
	if not ok then return nil end
	local n = 0
	if type(data) == "table" then for _ in pairs(data) do n += 1 end end
	return n
end
local function setFull(id, full)
	if full and not capfull[id] then
		if FS.req("PUT", "/capfull/" .. id, true) then capfull[id] = true end
	elseif not full and capfull[id] ~= false then
		if FS.req("DELETE", "/capfull/" .. id) then capfull[id] = false end
	end
end
local function dropCap(id)
	FS.req("DELETE", "/followcaps/" .. id)
	FS.req("DELETE", "/capfull/" .. id)
	capfull[id] = false
end

local function remoteCaps()
	local ok, data = FS.req("GET", "/followcaps")
	if not ok then return false end
	local seen = {}
	if type(data) == "table" then
		for id, c in pairs(data) do
			id = tostring(id)
			if type(c) == "table" and tonumber(c.max) and id:match("^%d+$") then
				seen[id] = true
				caps[id] = { max = math.max(0, math.floor(tonumber(c.max))), by = tostring(c.by or ""), ts = tonumber(c.ts) or 0, remote = true }
			end
		end
	end
	for id, c in pairs(caps) do
		if c.remote and not seen[id] then caps[id] = nil end -- lifted by another moderator
	end
	capSaveLocal()
	return true
end

local function drawCaps()
	if not (capList and capList.Parent) then return end
	for _, c in ipairs(capList:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local ids = {}
	for id in pairs(caps) do ids[#ids + 1] = id end
	table.sort(ids)
	if #ids == 0 then
		new("TextLabel", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Text = "No caps set.", Font = T.font, TextSize = 12,
			TextColor3 = T.mut, Parent = capList })
		return
	end
	for i, id in ipairs(ids) do
		local c = caps[id]
		local row = new("Frame", { Size = UDim2.new(1, -4, 0, 30), BackgroundColor3 = WHITE, BackgroundTransparency = 0.94, LayoutOrder = i, Parent = capList },
			{ corner(8) })
		new("TextLabel", { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -52, 1, 0), BackgroundTransparency = 1,
			Text = capName(id) .. "  ·  max " .. c.max .. (c.remote and "" or "  (local only)"), Font = T.font, TextSize = 12, TextColor3 = T.text,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		local x = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), Size = UDim2.fromOffset(34, 24),
			BackgroundTransparency = 1, Text = "✕", Font = T.fontB, TextSize = 14, TextColor3 = Color3.fromRGB(255, 120, 120), AutoButtonColor = false, Parent = row })
		x.Activated:Connect(function()
			if not isModNow() then return end
			dropCap(id)
			caps[id] = nil
			capSaveLocal()
			drawCaps()
			setStatus("Cap removed for " .. capName(id) .. ".", true)
		end)
	end
end

local function lookupUser(txt)
	txt = (txt or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if txt == "" then return nil end
	if txt:match("^%d+$") then return txt end
	local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(txt) end)
	if ok and id then return string.format("%.0f", id) end
	return nil
end

local function applyCap()
	if capBusy then return end
	if not isModNow() then setStatus("Moderators only.", false) return end
	local id = lookupUser(capUser.Text)
	local max = tonumber(capMax.Text)
	if not id then setStatus("Enter a valid user ID or username.", false) return end
	if not max or max < 0 or max ~= math.floor(max) then setStatus("Enter a whole number, 0 or more.", false) return end
	capBusy = true
	setStatus("Setting cap…")
	local rec = { max = max, by = tostring(ME), ts = os.time() * 1000 }
	local okp = FS.req("PUT", "/followcaps/" .. id, rec)
	caps[id] = { max = max, by = rec.by, ts = rec.ts, remote = okp and true or false }
	capSaveLocal()
	drawCaps()
	setStatus("Trimming…")
	local removed, failed, code = trim(id, max)
	if removed ~= nil then setFull(id, (countOf(id) or max) >= max) end
	capBusy = false
	if removed == nil then
		setStatus(tostring(failed), false)
	elseif failed > 0 then
		setStatus("Removed " .. removed .. ", " .. failed .. " refused (HTTP " .. tostring(code) .. "). Allow moderators to delete in the sxikiflowsys rules.", false)
	else
		setStatus((okp and "Cap saved" or "Cap kept locally (publish a /followcaps rule to share it)") .. (removed > 0 and ("  ·  removed " .. removed) or "") .. ".", okp and true or nil)
	end
end

local function removeCapFromBox()
	if not isModNow() then setStatus("Moderators only.", false) return end
	local id = lookupUser(capUser.Text)
	if not id or not caps[id] then setStatus("That user has no cap.", false) return end
	dropCap(id)
	caps[id] = nil
	capSaveLocal()
	drawCaps()
	setStatus("Cap removed for " .. capName(id) .. ".", true)
end

