	local left = #full - shown
	moreBtn = new("TextButton", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = WHITE, LayoutOrder = 100000,
		Text = "Load next " .. math.min(BATCH, left) .. "  ·  " .. left .. " more", Font = T.fontB, TextSize = 13, TextColor3 = INK2,
		AutoButtonColor = false, Parent = sc }, { corner(14), grad(20) })
	moreBtn.Activated:Connect(function() task.spawn(loadMore) end)
