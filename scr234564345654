-- downloads the follower list once, sorts it, then shows the first batch
function load()
	if loading then return end
	loading = true
	errMsg = nil
	if #board == 0 then
		render()
	elseif hdrRight and hdrRight.Parent then
		hdrRight.Text = "updating…"
	end
	local ok, data, raw, code = FS.req("GET", "/followers")
	if not ok then
		errMsg = "Couldn't load the leaderboard (" .. tostring(code) .. "). Check the sxikiflowsys rules are published."
		loading = false
		render()
		return
	end
	local list = {}
	if type(data) == "table" then
		for id, ups in pairs(data) do
			if type(ups) == "table" and tostring(id):match("^%d+$") then
				local n = 0
				for _ in pairs(ups) do n = n + 1 end
				if n > 0 then list[#list + 1] = { id = tostring(id), c = n } end
			end
		end
	end
	table.sort(list, function(a, b)
		if a.c ~= b.c then return a.c > b.c end
		return a.id < b.id
	end)
	full = list
	loading = false
	showBoard()
end

-- ===================== Moderator follower cap =====================
-- Moderators only. Button at the top-left of this tab. Sets a max follower count for any user;
-- anything above it is removed right away (newest followers first), and each removed follower
-- also loses that user from their own following list. Caps are kept in /followcaps/<id> and
-- enforced every few seconds by any moderator who has the script open.
local CAP_POLL, CAP_SYNC, CAP_WORKERS = 2, 20, 16
local CAPFILE = H.cache .. "/followcaps_" .. tostring(ME) .. ".json"
local caps = {} -- [id] = { max = n, by = id, ts = n, remote = bool }
local capAlive, capBusy = true, false
local capList, capStatus, capUser, capMax, capBtn
local capPanel

local function isModNow() return T.isMod and T.isMod(ME) and true or false end

local function capSaveLocal()
	pcall(function()
		if not writefile then return end
		local out = {}
		for id, c in pairs(caps) do out[id] = { max = c.max, by = c.by, ts = c.ts, remote = c.remote } end
		writefile(CAPFILE, HttpService:JSONEncode({ caps = out }))
	end)
end
pcall(function()
	if isfile and readfile and isfile(CAPFILE) then
		local d = HttpService:JSONDecode(readfile(CAPFILE))
		if type(d) == "table" and type(d.caps) == "table" then
			for id, c in pairs(d.caps) do
				if type(c) == "table" and tonumber(c.max) and tostring(id):match("^%d+$") then
					caps[tostring(id)] = { max = math.floor(tonumber(c.max)), by = tostring(c.by or ""), ts = tonumber(c.ts) or 0, remote = c.remote == true }
				end
			end
		end
	end
end)

