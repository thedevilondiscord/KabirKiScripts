-- Saiki Rechat plugin: Settings tab
-- SOURCE file. Obfuscate it with Ker0 (like the main script), then upload the obfuscated result to GitHub as SaikiRechat_Settings.lua
-- (folder = CONFIG.PLUGIN_BASE). The main script downloads it with game:HttpGet() and runs it with loadstring().
local H = ... or (getgenv and getgenv() or _G).SaikiRechatPlugin
-- Defensive startup: do not let this plugin initialize twice on the same Rechat instance.
if type(H) ~= "table" or type(H.T) ~= "table" or type(H.onDestroy) ~= "function" then
	warn("[SAIKI RECHAT] Settings plugin skipped: shared plugin API is unavailable.")
	return
end
local _loadedPlugins = H._loadedPlugins
if type(_loadedPlugins) ~= "table" then
	_loadedPlugins = {}
	H._loadedPlugins = _loadedPlugins
end
if _loadedPlugins.Settings then
	return
end
_loadedPlugins.Settings = true
H.onDestroy(function()
	_loadedPlugins.Settings = nil
end)
local T, gui, win, container, pages, winScale = H.T, H.gui, H.win, H.container, H.pages, H.winScale
local new, corner, stroke, grad, tween, toast, bind = H.new, H.corner, H.stroke, H.grad, H.tween, H.toast, H.bind
local newScroll, addHeader, fitScale, CONFIG = H.newScroll, H.addHeader, H.fitScale, H.CONFIG
local WHITE = Color3.new(1, 1, 1)
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")
local DISCORD, DISCORD_CODE = "https://discord.gg/63eEChZ6YU", "63eEChZ6YU"
local INK2 = Color3.fromRGB(15, 17, 25)

---------------------------------------------------------------- saved settings
local FILE = H.cache .. "/settings_" .. H.me .. ".json"
local MAXMSG = CONFIG.MAX_MESSAGES
local WHITEC = Color3.new(1, 1, 1)
local function mk(bg, accA, accB, light)
	local t = { bg = bg, accA = accA, accB = accB, text = Color3.fromRGB(240, 242, 250), mut = Color3.fromRGB(150, 156, 175), ov = WHITEC, bgT = 0.2 }
	if light then for k, v in pairs(light) do t[k] = v end end
	return t
end
local THEMES = {
	Dark   = mk(Color3.fromRGB(14, 16, 24), Color3.fromRGB(124, 92, 255), Color3.fromRGB(64, 180, 255)),
	AMOLED = mk(Color3.fromRGB(0, 0, 0),    Color3.fromRGB(140, 100, 255), Color3.fromRGB(70, 190, 255)),
	Ocean  = mk(Color3.fromRGB(8, 20, 32),  Color3.fromRGB(0, 140, 255),   Color3.fromRGB(0, 220, 200)),
	Sunset = mk(Color3.fromRGB(26, 14, 20), Color3.fromRGB(255, 100, 110), Color3.fromRGB(255, 176, 64)),
	Forest = mk(Color3.fromRGB(10, 22, 16), Color3.fromRGB(60, 190, 120),  Color3.fromRGB(150, 225, 80)),
	-- soft pink, solid (opaque) window, dark text
	Lovely = mk(Color3.fromRGB(255, 233, 241), Color3.fromRGB(255, 98, 158), Color3.fromRGB(176, 108, 255),
		{ text = Color3.fromRGB(62, 30, 52), mut = Color3.fromRGB(160, 104, 134), ov = Color3.fromRGB(214, 60, 120), bgT = 0 }),
	-- premium cream + gold, solid (opaque) window, dark brown text
	Gold   = mk(Color3.fromRGB(255, 246, 214), Color3.fromRGB(230, 148, 0), Color3.fromRGB(255, 198, 36),
		{ text = Color3.fromRGB(64, 45, 8), mut = Color3.fromRGB(150, 118, 42), ov = Color3.fromRGB(176, 120, 0), bgT = 0 }),
}
local ORDER = { "Dark", "AMOLED", "Ocean", "Sunset", "Forest", "Lovely", "Gold" }
if T.ov == nil then T.ov = WHITEC end
local V = { theme = "Dark", anim = true, aura = true, notif = true, guiMul = 1, anchored = true, ox = 0, oy = 0 }
pcall(function()
	if isfile and readfile and isfile(FILE) then
		local d = HttpService:JSONDecode(readfile(FILE))
		if type(d) == "table" then
			if THEMES[d.theme] then V.theme = d.theme end
			if type(d.anim) == "boolean" then V.anim = d.anim end
			if type(d.aura) == "boolean" then V.aura = d.aura end
			if type(d.notif) == "boolean" then V.notif = d.notif end
			if type(d.anchored) == "boolean" then V.anchored = d.anchored end
			if type(d.guiMul) == "number" then V.guiMul = math.clamp(d.guiMul, 0.6, 1.3) end
			if type(d.ox) == "number" then V.ox = d.ox end
			if type(d.oy) == "number" then V.oy = d.oy end
		end
	end
end)
local pending = false
local function save()
	if pending then return end
	pending = true
	task.delay(0.6, function()
		pending = false
		pcall(function() if writefile then writefile(FILE, HttpService:JSONEncode(V)) end end)
	end)
end

---------------------------------------------------------------- page + helpers
local page = H.page
for _, c in ipairs(page:GetChildren()) do c:Destroy() end
local sc = newScroll(page)
local order = 0
local TW = 447 - 12 - 76

local function textH(text, size, w)
	local ok, v = pcall(function() return TextService:GetTextSize(text, size, T.font, Vector2.new(w, 10000)).Y end)
	if ok and type(v) == "number" then return math.ceil(v) + 2 end
	return math.ceil(#text * size * 0.56 / w) * (size + 3)
end
local function header(text)
	order = order + 1
	addHeader(sc, text, order)
end
local function card(h)
	order = order + 1
	return new("Frame", { Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = WHITE, BackgroundTransparency = 0.94,
		LayoutOrder = order, Parent = sc }, { corner(14), stroke(0.92) })
end
local function title(c, text)
	new("TextLabel", { Position = UDim2.fromOffset(12, 11), Size = UDim2.new(1, -90, 0, 18), BackgroundTransparency = 1, Text = text,
		Font = T.fontB, TextSize = 14, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Left, Parent = c })
	return 33
end
local function desc(c, text, y, w)
	local h = textH(text, 12, w)
	new("TextLabel", { Position = UDim2.fromOffset(12, y), Size = UDim2.new(0, w, 0, h), BackgroundTransparency = 1, Text = text,
		TextWrapped = true, Font = T.font, TextSize = 12, TextColor3 = T.mut, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, Parent = c })
	return h
end

local function makeSwitch(parent, on, onChange)
	local state = on
	local track = new("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(44, 24),
		BackgroundColor3 = WHITE, BackgroundTransparency = 0.82, Text = "", AutoButtonColor = false, Parent = parent }, { corner(12) })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = on and 0 or 1,
		Parent = track }, { corner(12), grad(0) })
	local onPos, offPos = UDim2.new(1, -21, 0.5, 0), UDim2.new(0, 3, 0.5, 0)
	local knob = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = on and onPos or offPos, Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = WHITE, ZIndex = 2, Parent = track }, { corner(9) })
	local lbl = new("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 40), Size = UDim2.fromOffset(44, 14),
		BackgroundTransparency = 1, Text = on and "ON" or "OFF", Font = T.fontB, TextSize = 10, TextColor3 = T.mut, Parent = parent })
	track.Activated:Connect(function()
		state = not state
		lbl.Text = state and "ON" or "OFF"
		tween(fill, 0.2, { BackgroundTransparency = state and 0 or 1 })
		tween(knob, 0.2, { Position = state and onPos or offPos })
		if onChange then onChange(state) end
	end)
end
local function toggleRow(name, text, on, onChange)
	local dh = textH(text, 12, TW)
	local c = card(33 + dh + 14)
	local y = title(c, name)
	desc(c, text, y, TW)
	makeSwitch(c, on, onChange)
end

