do
	local text = "Pick any frame you have unlocked: the frames of your Tier and every lower Tier, plus any secret frame a moderator gave you. Everyone sees the one you pick. Auto = the frame of your own Tier."
	local dh = textH(text, 12, TW)
	local c = card(33 + dh + 10 + 30 + 12)
